# HiveMind — PRODUCTION environment template for docker-compose.prod.yml
#
# Copy to `.env.production` (git-ignored) and fill in REAL values from your secret manager / deployment
# tooling. This file holds variable NAMES and placeholders only — never commit real values.
#
# Passwords used inside URLs must be URL-safe (letters and digits only) or percent-encoded.

# ── Public URLs (HTTPS/WSS terminated by the reverse proxy) ──
PUBLIC_APP_ORIGIN=https://app.example.com
PUBLIC_API_ORIGIN=https://api.example.com
PUBLIC_WS_ORIGIN=wss://api.example.com

# ── Database ──
POSTGRES_OWNER_PASSWORD=generate-a-long-random-alphanumeric-value
APP_DB_PASSWORD=generate-a-different-long-random-alphanumeric-value

# ── Authentication ──
# Random, >= 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=generate-with-openssl-rand

# ── LLM (choose ONE provider; only its key is required) ──
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=your_groq_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here

# ── Reverse proxy address trusted for X-Forwarded-* (client IPs for rate limiting) ──
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Optional: secured Kafka (leave empty for the private compose network) ──
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

LOG_LEVEL=INFO
