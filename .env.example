# Copy to backend/.env (the backend reads .env from its working directory). Never commit real values.

# PostgreSQL + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://hivemind:password@localhost:5432/hivemind

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=hivemind.events
KAFKA_CONSUMER_GROUP=hivemind-scheduler

# LLM: choose ONE provider (groq | featherless). Only the selected provider's key is required.
LLM_PROVIDER=groq
# Empty = the provider default (groq: openai/gpt-oss-120b). Featherless has no default: set LLM_MODEL.
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Per-request timeout and the provider SDK's bounded transport retries (429 Retry-After / 5xx / connection)
# LLM_REQUEST_TIMEOUT_S=120
# LLM_MAX_RETRIES=3
LLM_REASONING_EFFORT=low
# Per-agent workflow timeout in seconds
AGENT_TIMEOUT_S=300
# Guardian revision loop: max Builder revisions per run before the run fails with MAX_REVISIONS_EXCEEDED
MAX_REVISIONS=3

# Embeddings + semantic memory (independent of the LLM). Local ONNX model via fastembed:
# no API key; the model (~130 MB) is downloaded once into backend/.model_cache.
# EMBEDDING_DIMENSION must match the model AND the agent_memories.embedding column (384).
# Set EMBEDDING_PROVIDER=none to disable memory.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# Retrieval: top-K memories with cosine similarity >= MEMORY_MIN_SIMILARITY; at most MEMORY_MAX_PER_RUN stored per run
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.60
MEMORY_MAX_PER_RUN=3

CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js, set in frontend/.env.local). Defaults shown; the WebSocket origin follows the API origin.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
# NEXT_PUBLIC_WS_ORIGIN=ws://localhost:8000
